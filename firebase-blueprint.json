{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "Announcements and notices for students",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the notice" },
        "content": { "type": "string", "description": "Contet of the notice" },
        "date": { "type": "string", "description": "Date of announcement" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "createdBy": { "type": "string", "description": "Admin UID" }
      },
      "required": ["title", "content", "date", "createdAt", "createdBy"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Student leads or contact inquiries",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "phone", "message", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator of the system",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Website customizable settings",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "announcementText": { "type": "string" },
        "announcementLink": { "type": "string" },
        "announcementActive": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["heroTitle", "heroSubtitle", "announcementText", "announcementLink", "announcementActive", "updatedAt"]
    },
    "Faculty": {
      "title": "Faculty",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "qualification": { "type": "string" },
        "specialization": { "type": "string" },
        "experience": { "type": "string" },
        "philosophy": { "type": "string" },
        "achievements": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "designation", "createdAt"]
    },
    "Topper": {
      "title": "Topper",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "score": { "type": "string" },
        "details": { "type": "string" },
        "school": { "type": "string" },
        "year": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "year", "createdAt"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "imageUrl", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "rating", "text", "status", "createdAt"]
    },
    "SiteImage": {
      "title": "Site Image",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "url": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["key", "url", "updatedAt"]
    },
    "DailyGS": {
      "title": "Daily GS Content",
      "description": "Automated GS facts and career tips",
      "type": "object",
      "properties": {
        "gsFacts": { "type": "array" },
        "careerTips": { "type": "array" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["gsFacts", "careerTips", "lastUpdated"]
    },
    "Institute": {
      "title": "Institute",
      "description": "Coaching institute tenant boundary for ERP operations",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "code": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "academicSession": { "type": "string", "minLength": 4, "maxLength": 40 },
        "timezone": { "type": "string", "minLength": 2, "maxLength": 60 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "code", "status", "ownerUid", "academicSession", "timezone", "createdAt", "updatedAt"]
    },
    "ErpUserProfile": {
      "title": "ERP User Profile",
      "description": "Identity profile keyed by Firebase Auth UID (no mutable role claims)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "defaultInstituteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "status", "createdAt", "updatedAt"]
    },
    "InstituteMembership": {
      "title": "Institute Membership",
      "description": "Trusted staff membership binding a Firebase UID to an institute and ERP role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instituteId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["institute_owner", "institute_admin", "accountant", "teacher"] },
        "status": { "type": "string", "enum": ["active", "suspended", "revoked"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "designation": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "instituteId", "role", "status", "displayName", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "notices": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Stores all notices and announcements"
    },
    "inquiries": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Stores contact form submissions"
    },
    "admins": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores legacy CMS admin users. Document ID is the admin's Email."
    },
    "settings": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Stores single document 'general' for website content."
    },
    "faculties": {
      "schema": { "$ref": "#/entities/Faculty" }
    },
    "toppers": {
      "schema": { "$ref": "#/entities/Topper" }
    },
    "gallery": {
      "schema": { "$ref": "#/entities/GalleryImage" }
    },
    "reviews": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews created by users."
    },
    "siteImages": {
      "schema": { "$ref": "#/entities/SiteImage" },
      "description": "Dynamic images used across the site"
    },
    "automated_content": {
      "schema": { "$ref": "#/entities/DailyGS" },
      "description": "Automated daily content periodically updated"
    },
    "institutes": {
      "schema": { "$ref": "#/entities/Institute" },
      "description": "ERP institute entities keyed by instituteId"
    },
    "users": {
      "schema": { "$ref": "#/entities/ErpUserProfile" },
      "description": "ERP staff identity profiles keyed by Firebase Auth UID"
    },
    "memberships": {
      "schema": { "$ref": "#/entities/InstituteMembership" },
      "description": "Institute-scoped staff memberships keyed by {instituteId}_{uid}"
    }
  }
}
