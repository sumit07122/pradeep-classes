rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidEmailId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSuperAdmin() { 
      return isVerifiedUser() && (
        request.auth.token.email == 'sumitdevthakur@gmail.com' ||
        request.auth.token.email == 'pradeepclasses.in@gmail.com'
      ); 
    }
    function isAdmin() { 
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); 
    }

    // ERP Membership & Institute Helpers
    function membershipPath(instituteId, uid) {
      return /databases/$(database)/documents/memberships/$(instituteId + '_' + uid);
    }
    function isActiveUserRecord() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function isActiveInstituteMember(instituteId) {
      return isVerifiedUser() &&
             isActiveUserRecord() &&
             exists(membershipPath(instituteId, request.auth.uid)) &&
             get(membershipPath(instituteId, request.auth.uid)).data.status == 'active';
    }
    function isActiveInstitute(instituteId) {
      return exists(/databases/$(database)/documents/institutes/$(instituteId)) &&
             get(/databases/$(database)/documents/institutes/$(instituteId)).data.status == 'active';
    }
    function hasInstituteRole(instituteId, allowedRoles) {
      return isActiveInstituteMember(instituteId) &&
             get(membershipPath(instituteId, request.auth.uid)).data.role in allowedRoles;
    }
    function isInstituteOwner(instituteId) {
      return hasInstituteRole(instituteId, ['institute_owner']);
    }
    function isInstitutePrivileged(instituteId) {
      return hasInstituteRole(instituteId, ['institute_owner', 'institute_admin']);
    }

    // Legacy Public Website & CMS Validators
    function isValidNotice(data) {
      return data.keys().hasAll(['title', 'content', 'date', 'createdAt', 'createdBy']) &&
             data.keys().size() <= 5 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
             data.createdAt is timestamp &&
             data.createdBy is string && data.createdBy == request.auth.uid;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'status', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status is string && data.status.matches('^(new|contacted|resolved)$') &&
             data.createdAt is timestamp &&
             (data.get('email', '') is string && data.get('email', '').size() <= 100);
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() <= 2 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.createdAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['heroTitle', 'heroSubtitle', 'announcementText', 'announcementLink', 'announcementActive', 'updatedAt']) &&
             data.keys().size() <= 6 &&
             data.heroTitle is string && data.heroTitle.size() > 0 && data.heroTitle.size() <= 200 &&
             data.heroSubtitle is string && data.heroSubtitle.size() > 0 && data.heroSubtitle.size() <= 600 &&
             data.announcementText is string && data.announcementText.size() <= 500 &&
             data.announcementLink is string && data.announcementLink.size() <= 500 &&
             data.announcementActive is bool &&
             data.updatedAt is timestamp;
    }

    function isValidFaculty(data) {
      return data.keys().hasAll(['name', 'designation', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.designation is string && data.designation.size() > 0 && data.designation.size() <= 100 &&
             (data.get('qualification', '') is string && data.get('qualification', '').size() <= 200) &&
             (data.get('specialization', '') is string && data.get('specialization', '').size() <= 200) &&
             (data.get('experience', '') is string && data.get('experience', '').size() <= 200) &&
             (data.get('philosophy', '') is string && data.get('philosophy', '').size() <= 1000) &&
             (data.get('achievements', '') is string && data.get('achievements', '').size() <= 1000) &&
             (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 1000) &&
             (data.get('order', 0) is number) &&
             data.createdAt is timestamp;
    }

    function isValidTopper(data) {
      return data.keys().hasAll(['name', 'year', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.year is string && data.year.size() > 0 && data.year.size() <= 10 &&
             (data.get('score', '') is string && data.get('score', '').size() <= 100) &&
             (data.get('details', '') is string && data.get('details', '').size() <= 500) &&
             (data.get('school', '') is string && data.get('school', '').size() <= 200) &&
             (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 1000) &&
             data.createdAt is timestamp;
    }

    function isValidGalleryImage(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'createdAt']) &&
             data.keys().size() <= 3 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'text', 'status', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             data.status is string && data.status.matches('^(pending|approved)$') &&
             data.createdAt is timestamp &&
             (data.get('email', '') is string && data.get('email', '').size() <= 100);
    }

    function isValidSiteImage(data) {
      return data.keys().hasAll(['key', 'url', 'updatedAt']) &&
             data.keys().size() <= 3 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 100 &&
             data.url is string && data.url.size() > 0 && data.url.size() <= 1000 &&
             data.updatedAt is timestamp;
    }

    function isValidAutomatedContent(data) {
      return data.keys().hasAll(['gsFacts', 'careerTips', 'lastUpdated']) &&
             data.keys().size() <= 4 &&
             data.gsFacts is list &&
             data.careerTips is list &&
             data.lastUpdated is timestamp;
    }

    // ERP Foundation Validators
    function isValidInstitute(data) {
      return data.keys().hasAll(['name', 'code', 'status', 'ownerUid', 'academicSession', 'timezone', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'code', 'status', 'ownerUid', 'academicSession', 'timezone', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9\\-]+$') &&
             data.status is string && data.status in ['active', 'suspended'] &&
             data.ownerUid is string && isValidId(data.ownerUid) &&
             data.academicSession is string && data.academicSession.size() >= 4 && data.academicSession.size() <= 40 &&
             data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 60 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidErpUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'photoURL', 'status', 'defaultInstituteId', 'createdAt', 'updatedAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             data.status is string && data.status in ['active', 'disabled'] &&
             (!('defaultInstituteId' in data) || (data.defaultInstituteId is string && isValidId(data.defaultInstituteId))) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidMembership(data) {
      return data.keys().hasAll(['uid', 'instituteId', 'role', 'status', 'displayName', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'instituteId', 'role', 'status', 'displayName', 'designation', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.instituteId is string && isValidId(data.instituteId) &&
             data.role is string && data.role in ['institute_owner', 'institute_admin', 'accountant', 'teacher'] &&
             data.status is string && data.status in ['active', 'suspended', 'revoked'] &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Legacy Public Website & CMS Collections
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isValidId(noticeId) && isAdmin() && isValidNotice(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(noticeId) && isAdmin() && isValidNotice(incoming()) && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(noticeId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().status == 'new' && incoming().createdAt == request.time;
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiry(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.token.email == adminId);
      allow create: if isValidEmailId(adminId) && isSuperAdmin() && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidEmailId(adminId) && isSuperAdmin() && isValidAdmin(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidEmailId(adminId) && isSuperAdmin();
      allow list: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if settingId == 'general' && isAdmin() && isValidSetting(incoming()) && incoming().updatedAt == request.time;
      allow update: if settingId == 'general' && isAdmin() && isValidSetting(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['heroTitle', 'heroSubtitle', 'announcementText', 'announcementLink', 'announcementActive', 'updatedAt']) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /faculties/{facultyId} {
      allow read: if true;
      allow create: if isValidId(facultyId) && isAdmin() && isValidFaculty(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(facultyId) && isAdmin() && isValidFaculty(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(facultyId) && isAdmin();
    }

    match /toppers/{topperId} {
      allow read: if true;
      allow create: if isValidId(topperId) && isAdmin() && isValidTopper(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(topperId) && isAdmin() && isValidTopper(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(topperId) && isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isValidId(imageId) && isAdmin() && isValidGalleryImage(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(imageId) && isAdmin() && isValidGalleryImage(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(imageId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidId(reviewId) && isValidReview(incoming()) && incoming().status == 'pending' && incoming().createdAt == request.time;
      allow update: if isValidId(reviewId) && isAdmin() && isValidReview(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(reviewId) && isAdmin();
      allow list: if isAdmin() || resource.data.status == 'approved';
    }

    match /siteImages/{imageId} {
      allow read: if true;
      allow create: if isValidId(imageId) && isAdmin() && isValidSiteImage(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(imageId) && isAdmin() && isValidSiteImage(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(imageId) && isAdmin();
    }

    match /automated_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidAutomatedContent(incoming());
    }

    // ERP Foundation Collections (Institute-Scoped Zero-Trust RBAC)
    match /institutes/{instituteId} {
      allow get: if isValidId(instituteId) && (isActiveInstituteMember(instituteId) || isSuperAdmin());
      allow list: if isSuperAdmin() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(instituteId) &&
                       isSuperAdmin() &&
                       isValidInstitute(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isValidId(instituteId) &&
                       isValidInstitute(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (
                         isSuperAdmin() ||
                         (
                           isInstituteOwner(instituteId) &&
                           existing().status == 'active' &&
                           incoming().status == existing().status &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'academicSession', 'timezone', 'updatedAt'])
                         )
                       );
      allow delete: if isValidId(instituteId) && isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && ((isVerifiedUser() && request.auth.uid == userId) || isSuperAdmin());
      allow list: if isSuperAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) &&
                       isSuperAdmin() &&
                       isValidErpUser(incoming()) &&
                       incoming().uid == userId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
                       isValidErpUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (
                         isSuperAdmin() ||
                         (
                           isVerifiedUser() &&
                           request.auth.uid == userId &&
                           existing().status == 'active' &&
                           incoming().status == existing().status &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'defaultInstituteId', 'updatedAt']) &&
                           (
                             !('defaultInstituteId' in incoming()) ||
                             incoming().defaultInstituteId == existing().get('defaultInstituteId', '') ||
                             isActiveInstituteMember(incoming().defaultInstituteId)
                           )
                         )
                       );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    match /memberships/{membershipId} {
      allow get: if isValidId(membershipId) &&
                    isVerifiedUser() &&
                    (
                      resource.data.uid == request.auth.uid ||
                      isInstitutePrivileged(resource.data.instituteId) ||
                      isSuperAdmin()
                    );
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isValidId(membershipId) &&
                       isValidMembership(incoming()) &&
                       membershipId == (incoming().instituteId + '_' + incoming().uid) &&
                       isActiveInstitute(incoming().instituteId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       (
                         isSuperAdmin() ||
                         (
                           isInstituteOwner(incoming().instituteId) &&
                           incoming().role != 'institute_owner'
                         )
                       );
      allow update: if isValidId(membershipId) &&
                       isValidMembership(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().instituteId == existing().instituteId &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'designation', 'updatedAt']) &&
                       (
                         isSuperAdmin() ||
                         (
                           isInstituteOwner(existing().instituteId) &&
                           isActiveInstitute(existing().instituteId) &&
                           existing().role != 'institute_owner' &&
                           incoming().role != 'institute_owner'
                         )
                       );
      allow delete: if isValidId(membershipId) && isSuperAdmin();
    }
  }
}
